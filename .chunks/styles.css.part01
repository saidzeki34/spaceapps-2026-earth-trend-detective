  .readout small, .readout span { font-size: 10px; letter-spacing: .05em; }
}

/* ---------------------------------------------------------------- data dialog */
.about { margin: auto; width: min(760px, 92vw); max-height: 86vh; background: var(--k); color: var(--w); border: 1px solid var(--w); padding: 0; text-transform: none; letter-spacing: 0; font-size: 13px; }
.about::backdrop { background: rgba(0, 0, 0, .72); }
.about header { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--w); }
.about h2 { font: 700 28px/1 var(--fc); text-transform: uppercase; }
.about button { border: 1px solid var(--w); padding: 4px 10px 3px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
.about button:hover { background: var(--w); color: var(--k); }
.about table { width: 100%; border-collapse: collapse; }
.about th, .about td { text-align: left; padding: 8px 16px; border-bottom: 1px solid var(--rk); vertical-align: top; }
.about th { color: var(--gk); font-weight: 400; }
.about td.ok { color: var(--w); } .about td.na { color: var(--o); }
.about td code { color: var(--gk); overflow-wrap: anywhere; }
.about p { padding: 12px 16px 0; color: var(--gk); line-height: 1.5; }
.about #about-body > button { margin: 14px 16px 16px; }

/* ---------------------------------------------------------------- map */
.leaflet-container { background: #050505; font: 12px/1.3 var(--f); }
.leaflet-bar { border: 1px solid var(--w) !important; border-radius: 0 !important; box-shadow: none !important; }
.leaflet-bar a { background: var(--k) !important; color: var(--w) !important; border-radius: 0 !important; border-bottom: 1px solid var(--rk) !important; width: 28px !important; height: 28px !important; line-height: 26px !important; font: 400 18px var(--f) !important; }
.leaflet-bar a:hover { background: var(--w) !important; color: var(--k) !important; }
.leaflet-control-attribution { background: rgba(10, 10, 10, .78) !important; color: #b5b5b0 !important; font-size: 10px !important; padding: 2px 6px !important; }
.leaflet-control-attribution a { color: #d5d5d0 !important; }
.map-back { background: var(--k); color: var(--w); border: 1px solid var(--w); padding: 6px 10px 5px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
.map-back:hover { background: var(--w); color: var(--k); }
.map-label { transform: translate(-50%, -50%); white-space: nowrap; font: 700 34px/1 var(--fc); letter-spacing: .02em; text-transform: uppercase; color: var(--w); cursor: pointer; padding: 6px 10px 4px; }
.map-label:hover { background: var(--w); color: var(--k); }
.gauge { width: 9px; height: 9px; background: var(--w); border: 1px solid var(--k); }
.gauge.dim { opacity: .55; }
.gauge.sel { width: 13px; height: 13px; margin: -2px 0 0 -2px; background: var(--o); border-color: var(--w); }
.map-tip { background: var(--k) !important; color: var(--w) !important; border: 1px solid var(--w) !important; border-radius: 0 !important; box-shadow: none !important;
  font: 600 12px/1.3 var(--f) !important; letter-spacing: .06em; text-transform: uppercase; padding: 5px 8px 4px !important; }
.map-tip small { display: block; font-weight: 400; color: var(--gk); font-size: 10px; letter-spacing: .08em; }
.map-tip.selected { background: var(--o) !important; border-color: var(--o) !important; color: var(--k) !important; }
.leaflet-tooltip.map-tip::before { display: none; }
.map-error { position: absolute; inset: 0; display: grid; place-items: center; color: var(--gk); }

/* ---------------------------------------------------------------- small windows */
@media (max-width: 1180px) { :root { --side: 248px; } }
@media (max-height: 760px) { .side-head { padding: 10px 16px 9px; } .grp { padding: 8px 16px 9px; } .check { padding: 2px 0; } }
@media (max-width: 860px) {
  body { overflow: auto; }
  #app { height: auto; min-height: 100%; }
  .layout, .layout.has-results, .layout.has-results.has-time, .layout.has-results.expanded, .layout.has-results.has-time.expanded {
    grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; grid-template-areas: "side" "map" "time" "res"; }
  .mapwrap { height: 52vh; } .grip { display: none; } .side { border-right: 0; max-height: 46vh; }
  .time { height: 76px; }
  .crumbs { display: none; }
  .pick li button { grid-template-columns: 40px minmax(0, 1fr); } .pick .ind { display: none; }
}
@media (prefers-reduced-motion: reduce) { .splash-bar i { animation: none; width: 60%; } }
